rules_version = '2';

// Review proof photos (ticket + dish). Publicly readable — they're shown to every visitor
// on the spot detail screen — but only a signed-in user can upload one, and only a small
// image file (guards against someone using the bucket as free file hosting).
service firebase.storage {
  match /b/{bucket}/o {
    match /reviews/{spotId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
