rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins can see their own doc (used by the "access denied" bootstrap screen) and manage
    // the allowlist once they're in it (grant/revoke admin from the console's Users tab).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    match /spots/{spotId} {
      allow read: if request.auth != null;

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['reviews', 'rating', 'reviewCount']));
    }

    // Denylist of blocked phone numbers. Publicly readable (not sensitive — just a list of
    // numbers) so the mobile app can check it *before* a user is signed in, since phone
    // sign-in itself is how a user becomes authenticated. Only admins can edit the list.
    match /blockedPhones/{phone} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profile data (display name, profile photo). Any signed-in user can read (shown next to
    // reviews later), but only the owner can write their own doc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
