# Copie ce fichier vers .env et remplis-le avec la config de ton projet Firebase
# (Firebase Console > Paramètres du projet > Vos applications > App Web > SDK setup and configuration).
# Sans ce fichier, l'app tourne en "mode démo" (login factice, pas d'auth réelle).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Needed only for Google Sign-In on native (iOS/Android) builds. Not required on web —
# the web flow uses a popup and needs no client ID in app code.
# Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
# (Firebase creates this automatically once you enable the Google provider.)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
