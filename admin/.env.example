# Copie vers .env.local pour le dev local (Vite le charge automatiquement).
# En prod (Render), ces mêmes clés sont définies comme variables d'environnement du service.
# Ce sont les mêmes valeurs que celles utilisées par l'app mobile (.env.example à la racine du repo) :
# même projet Firebase, donc les deux apps lisent/écrivent la même base Firestore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL of the admin-backend service (see ../admin-backend/), used by the Users tab
# (list users, create admin accounts — anything requiring the Firebase Admin SDK).
VITE_ADMIN_BACKEND_URL=
